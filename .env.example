# ============================================================
# 轻屿 环境变量示例。复制为 .env.local 后按需修改。
# 全部留空即可跑通 mock 模式（无需任何 API key），全站可完整演示。
# ============================================================

# ---- LLM ----
# 供应商标注，仅用于日志显示。实际走 OpenAI 兼容协议，由 LLM_BASE_URL 决定连谁。
# 可选值示例：openai | deepseek | moonshot | zhipu | dashscope | custom
LLM_PROVIDER=

# API Key。留空 = mock 模式：所有 AI 功能返回本地预设回复。
LLM_API_KEY=

# OpenAI 兼容接口地址，例如 https://api.openai.com/v1 、https://api.deepseek.com/v1
LLM_BASE_URL=

# 主生成模型（对话回复用）
LLM_MODEL_MAIN=

# 小模型（风险分类 / 输出审查 / 状态摘要用）
LLM_MODEL_SMALL=

# ---- 应用 ----
# 站点语言与资源地区，默认 zh-CN
APP_LOCALE=zh-CN
